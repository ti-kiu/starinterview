29:["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6","children":[["$","div","Situation",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Situation"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I identified that our authentication system was a bottleneck affecting 5 different product teams, but each team had different priorities and no one wanted to invest in fixing it."}]]}],["$","div","Task",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-green-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Task"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I needed to build consensus across teams with competing priorities to invest in a shared solution."}]]}],["$","div","Action",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Action"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I quantified the problem: 15% of all P1 incidents were auth-related, costing each team 10+ hours per month. I created a proposal with a phased approach that minimized disruption to each team's roadmap. I presented to each team individually, addressing their specific concerns, then facilitated a joint planning session to align on the timeline."}]]}],["$","div","Result",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Result"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"All 5 teams committed to the migration. Auth-related incidents dropped by 90%, saving each team 10+ hours per month. The cross-functional collaboration model I established was adopted for other shared infrastructure projects."}]]}]]}]
2a:["$","div",null,{"className":"bg-amber-50 border border-amber-200 rounded-xl p-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-800 mb-2","children":"💡 Tips for this answer"}],["$","ul",null,{"className":"space-y-1","children":[["$","li","0",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Show you understand each stakeholder's perspective and constraints."}]]}],["$","li","1",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Demonstrate you used data to build the business case."}]]}],["$","li","2",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Highlight the lasting collaboration model, not just the immediate solution."}]]}]]}]]}]
2b:["$","div","2",{"className":"bg-white rounded-2xl border border-neutral-200 p-6 md:p-8","children":[["$","div",null,{"className":"flex items-start gap-3 mb-6","children":[["$","span",null,{"className":"shrink-0 w-8 h-8 rounded-lg bg-primary text-white text-sm font-bold flex items-center justify-center","children":3}],["$","h3",null,{"className":"text-lg font-bold","children":"Give an example of how you drove impact beyond your immediate team."}]]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6","children":[["$","div","Situation",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Situation"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I noticed that engineers across the organization were spending significant time setting up local development environments — an average of 2 days for new hires."}]]}],["$","div","Task",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-green-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Task"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I wanted to solve this problem not just for my team, but for the entire engineering organization."}]]}],["$","div","Action",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Action"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I built a one-click development environment setup tool using containerization. I wrote comprehensive documentation, created video tutorials, and organized two workshops to teach people how to use it. I also gathered feedback from 20 engineers across different teams to ensure it worked for diverse setups."}]]}],["$","div","Result",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Result"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"New hire setup time dropped from 2 days to 30 minutes. The tool was adopted by 15+ teams and became the standard development environment across the organization. It was featured in our engineering blog and received 3,000+ external stars on GitHub."}]]}]]}],["$","div",null,{"className":"bg-amber-50 border border-amber-200 rounded-xl p-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-800 mb-2","children":"💡 Tips for this answer"}],["$","ul",null,{"className":"space-y-1","children":[["$","li","0",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Show you think beyond your team's boundaries."}]]}],["$","li","1",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Demonstrate you invested in adoption, not just building the solution."}]]}],["$","li","2",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Quantify impact across the organization, not just your team."}]]}]]}]]}]]}]
