22:["$","section",null,{"className":"pb-12","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-5","children":[["$","h2",null,{"className":"text-2xl font-bold mb-8","children":[3," Interview Questions with STAR Answers"]}],["$","div",null,{"className":"space-y-8","children":[["$","div","0",{"className":"bg-white rounded-2xl border border-neutral-200 p-6 md:p-8","children":[["$","div",null,{"className":"flex items-start gap-3 mb-6","children":[["$","span",null,{"className":"shrink-0 w-8 h-8 rounded-lg bg-primary text-white text-sm font-bold flex items-center justify-center","children":1}],["$","h3",null,{"className":"text-lg font-bold","children":"Tell me about a time you led a project without being the official leader."}]]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6","children":[["$","div","Situation",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Situation"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"Our team needed to migrate 50 microservices to a new container orchestration platform, but no one was assigned to lead the effort."}]]}],["$","div","Task",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-green-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Task"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I saw the risk of coordination failure and stepped up to organize the migration, even though I wasn't the most senior engineer."}]]}],["$","div","Action",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Action"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I created a migration playbook with step-by-step instructions, set up a shared tracker for progress visibility, organized weekly sync meetings, and paired less experienced engineers with senior ones. I also built an automated validation script that verified each migration was successful before moving to the next."}]]}],["$","div","Result",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Result"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"We completed the migration in 8 weeks — 2 weeks ahead of schedule with zero production incidents. My playbook was adopted by 3 other teams doing similar migrations. I was promoted to Tech Lead the following quarter."}]]}]]}],["$","div",null,{"className":"bg-amber-50 border border-amber-200 rounded-xl p-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-800 mb-2","children":"💡 Tips for this answer"}],["$","ul",null,{"className":"space-y-1","children":[["$","li","0",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Show you lead by creating clarity and enabling others, not by directing."}]]}],["$","li","1",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Demonstrate you made the work easier for everyone, not just yourself."}]]}],["$","li","2",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Highlight that your leadership was recognized formally (promotion, praise, adoption)."}]]}]]}]]}]]}],["$","div","1",{"className":"bg-white rounded-2xl border border-neutral-200 p-6 md:p-8","children":[["$","div",null,{"className":"flex items-start gap-3 mb-6","children":["$L27","$L28"]}],"$L29","$L2