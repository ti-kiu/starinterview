t-lg text-neutral-600 leading-relaxed","children":"Meta interviews evaluate you against their core values: Move Fast, Be Bold, Focus on Long-term Impact, Build Awesome Things, and Live in the Future. Behavioral questions map directly to these values."}]]}]}],["$","section",null,{"className":"pb-12","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-5","children":["$","div",null,{"className":"bg-white rounded-2xl border border-neutral-200 p-6 md:p-8","children":[["$","h2",null,{"className":"text-xl font-bold mb-4","children":"Why Interviewers Ask These Questions"}],["$","ul",null,{"className":"space-y-3","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-1 shrink-0 w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center text-primary text-xs font-bold","children":1}],["$","span",null,{"className":"text-neutral-700","children":"Meta values 'Move Fast' — they want to see you ship quickly and iterate."}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-1 shrink-0 w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center text-primary text-xs font-bold","children":2}],["$","span",null,{"className":"text-neutral-700","children":"They look for 'Be Bold' — taking calculated risks, not playing it safe."}]]}],["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-1 shrink-0 w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center text-primary text-xs font-bold","children":3}],["$","span",null,{"className":"text-neutral-700","children":"Impact at scale is non-negotiable — Meta serves billions of users."}]]}]]}]]}]}]}],["$","section",null,{"className":"pb-12","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-5","children":["$L1d","$L1e"]}]}],"$L1f","$L20","$L21","$L22"]}]]
