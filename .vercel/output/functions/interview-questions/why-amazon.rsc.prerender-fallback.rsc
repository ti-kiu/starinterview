26:["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6","children":[["$","div","Situation",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Situation"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"In my previous role, I often felt constrained by layers of approval that slowed down decision-making and frustrated customers."}]]}],["$","div","Task",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-green-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Task"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I was looking for an environment where I could take ownership and move fast on behalf of customers."}]]}],["$","div","Action",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Action"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I told the interviewer about a specific instance where I proposed a customer-facing change that took 3 months to approve at my current company. I explained that Amazon's 'Bias for Action' principle — the idea that speed matters in business — directly addresses the frustration I felt. I also highlighted how 'Have Backbone; Disagree and Commit' encourages healthy debate."}]]}],["$","div","Result",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Result"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"The interviewer asked three follow-up questions, which showed genuine engagement with my answer. They later told me my response demonstrated a deep understanding of how Amazon's culture differs from other companies."}]]}]]}]
27:["$","div",null,{"className":"bg-amber-50 border border-amber-200 rounded-xl p-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-800 mb-2","children":"💡 Tips for this answer"}],["$","ul",null,{"className":"space-y-1","children":[["$","li","0",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Be honest about what frustrates you in your current role and how Amazon's culture solves it."}]]}],["$","li","1",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Show you understand the culture isn't just perks — it's a specific way of working."}]]}],["$","li","2",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Demonstrate you've thought about the trade-offs of Amazon's demanding culture."}]]}]]}]]}]
28:["$","div","2",{"className":"bg-white rounded-2xl border border-neutral-200 p-6 md:p-8","children":[["$","div",null,{"className":"flex items-start gap-3 mb-6","children":[["$","span",null,{"className":"shrink-0 w-8 h-8 rounded-lg bg-primary text-white text-sm font-bold flex items-center justify-center","children":3}],["$","h3",null,{"className":"text-lg font-bold","children":"How do your values align with Amazon's Leadership Principles?"}]]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6","children":[["$","div","Situation",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Situation"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"Throughout my career, I've consistently prioritized long-term customer relationships over short-term revenue wins."}]]}],["$","div","Task",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-green-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Task"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I needed to demonstrate that my personal values align with Amazon's principles in a concrete way."}]]}],["$","div","Action",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Action"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I shared an example where I turned down a quick revenue opportunity because it would have created a poor customer experience. I explained that this was my natural instinct long before I knew about Amazon's 'Customer Obsession' principle. I also connected my habit of diving deep into data before making decisions to Amazon's 'Dive Deep' principle."}]]}],["$","div","Result",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Result"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"The interviewer said my example was a textbook demonstration of Customer Obsession and noted that the alignment seemed organic rather than rehearsed. It set a strong foundation for the rest of my behavioral interviews."}]]}]]}],["$","div",null,{"className":"bg-amber-50 border border-amber-200 rounded-xl p-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-800 mb-2","children":"💡 Tips for this answer"}],["$","ul",null,{"className":"space-y-1","children":[["$","li","0",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Share examples that show your values existed before you learned about Amazon's principles."}]]}],["$","li","1",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Map 2-3 specific stories to specific Leadership Principles."}]]}],["$","li","2",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Show the alignment is genuine, not performative."}]]}]]}]]}]]}]
