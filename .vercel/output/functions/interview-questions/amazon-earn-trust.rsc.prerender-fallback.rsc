13:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Amazon Earn Trust Interview Questions & How to Answer\",\"description\":\"Prepare for Amazon's Earn Trust Leadership Principle interview questions. Learn what interviewers look for and practice with STAR method examples.\",\"author\":{\"@type\":\"Organization\",\"name\":\"StarInterview\",\"url\":\"https://starinterview.org\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"StarInterview\",\"url\":\"https://starinterview.org\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://starinterview.org/favicon-32.png\"}},\"datePublished\":\"2026-07-26\",\"dateModified\":\"2026-07-26\",\"mainEntityOfPage\":\"https://starinterview.org/interview-questions/amazon-earn-trust\",\"image\":\"https://starinterview.org/og-image.png\",\"speakable\":{\"@type\":\"SpeakableSpecification\",\"cssSelector\":[\"h1\",\"h2\",\".speakable\"]}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How is Earn Trust different from other Amazon Leadership Principles?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Earn Trust is uniquely about interpersonal dynamics. While principles like 'Customer Obsession' or 'Deliver Results' focus on outcomes, Earn Trust focuses on how you interact with others. Bar Raisers pay special attention to this principle because it's a strong indicator of team fit.\"}},{\"@type\":\"Question\",\"name\":\"Can I use a failure story for Earn Trust questions?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Absolutely. Showing you can be vocally self-critical — admitting a mistake, owning it, and showing what you learned — is one of the strongest demonstrations of Earn Trust. Amazon values leaders who are willing to say 'I was wrong.'\"}}]}"}}],["$","div",null,{"className":"bg-neutral-50 min-h-screen","children":[["$","section",null,{"className":"pt-16 pb-8 md:pt-24 md:pb-12","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-5","children":[["$","p",null,{"className":"text-xs font-semibold text-accent uppercase tracking-wider mb-3","children":"By Company"}],["$","h1",null,{"className":"text-3xl md:text-4xl font-bold mb-4","children":"Amazon Earn Trust Interview Questions & How to Answer"}],["$","p",null,{"className":"text-lg text-neutral-600 leading-relaxed","children":"Earn Trust is one of Amazon's 16 Leadership Principles. It focuses on listening attentively, speaking candidly, treating others respectfully, and being willing to be vocally self-critical. Interviewers assess whether you build trust through transparency and follow-through."}]]}]}],["$","section",null,{"className":"pb-12","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-5","children":["$","div",null,{"className":"bg-white rounded-2xl border border-neutral-200 p-6 md:p-8","children":[["$","h2",null,{"className":"text-xl font-bold mb-4","children":"Why Interviewers Ask These Questions"}],["$","ul",null,{"className":"space-y-3","children":[["$","li","0",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-1 shrink-0 w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center text-primary text-xs font-bold","children":1}],["$","span",null,{"className":"text-neutral-700","children":"Amazon's Bar Raisers specifically probe for Earn Trust because it's hard to fake."}]]}],["$","li","1",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-1 shrink-0 w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center text-primary text-xs font-bold","children":2}],"$L1d"]}],"$L1e","$L1f"]}]]}]}]}],"$L20","$L21","$L22","$L23","$L24"]}]]
1d:["$","span",null,{"className":"text-neutral-700","children":"Trust-building is essential for Amazon's high-ownership, decentralized culture."}]
1e:["$","li","2",{"className":"flex items-start gap-3","children":[["$","span",null,{"className":"mt-1 shrink-0 w-5 h-5 rounded-full bg-primary/10 flex items-center justify-center text-primary text-xs font-bold","children":3}],["$","span",null,{"className":"text-neutral-700","children":"They want to see you can be honest about mistakes and learn from feedback."}]]}]
