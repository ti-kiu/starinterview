27:["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6","children":[["$","div","Situation",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Situation"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"During a 360 review, my peers gave me feedback that I tended to dominate meetings and didn't create enough space for quieter team members."}]]}],["$","div","Task",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-green-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Task"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I needed to genuinely internalize the feedback and change my behavior, not just acknowledge it."}]]}],["$","div","Action",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Action"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I thanked each person who gave feedback and asked for specific examples. I then implemented three changes: I started ending my contributions with questions to invite others, I set up a pre-meeting async doc so people could contribute ideas before the meeting, and I asked a trusted colleague to flag me if I was dominating again."}]]}],["$","div","Result",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Result"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"Over the next quarter, meeting participation from quieter team members increased by 40%. My manager noted the change in my next review, and the async doc process was adopted team-wide."}]]}]]}]
28:["$","div",null,{"className":"bg-amber-50 border border-amber-200 rounded-xl p-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-800 mb-2","children":"💡 Tips for this answer"}],["$","ul",null,{"className":"space-y-1","children":[["$","li","0",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Show you accept feedback gracefully, not defensively."}]]}],["$","li","1",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Demonstrate specific behavioral changes, not just acknowledgment."}]]}],["$","li","2",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Highlight the systemic improvement that came from the feedback."}]]}]]}]]}]
29:["$","div","2",{"className":"bg-white rounded-2xl border border-neutral-200 p-6 md:p-8","children":[["$","div",null,{"className":"flex items-start gap-3 mb-6","children":[["$","span",null,{"className":"shrink-0 w-8 h-8 rounded-lg bg-primary text-white text-sm font-bold flex items-center justify-center","children":3}],["$","h3",null,{"className":"text-lg font-bold","children":"Give an example of when you had to deliver bad news to a stakeholder."}]]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6","children":[["$","div","Situation",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Situation"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"A critical feature we promised a major enterprise customer was going to be delayed by 3 weeks due to unexpected technical complexity."}]]}],["$","div","Task",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-green-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Task"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I needed to communicate the delay while maintaining the customer's trust and our relationship."}]]}],["$","div","Action",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Action"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I called the customer directly instead of sending an email. I explained the specific technical issue, shared the steps we were taking to resolve it, offered a temporary workaround, and proposed a revised timeline with built-in buffer. I also escalated internally to get additional engineering resources."}]]}],["$","div","Result",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Result"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"The customer appreciated the transparency and said it was the first time a vendor had proactively communicated a delay with a clear plan. They renewed their contract for 3 years and later cited our transparency as a key differentiator."}]]}]]}],["$","div",null,{"className":"bg-amber-50 border border-amber-200 rounded-xl p-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-800 mb-2","children":"💡 Tips for this answer"}],["$","ul",null,{"className":"space-y-1","children":[["$","li","0",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Deliver bad news proactively and directly — never hide it."}]]}],["$","li","1",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Always pair bad news with a plan or alternative."}]]}],["$","li","2",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Show that transparency strengthened, not damaged, the relationship."}]]}]]}]]}]]}]
