20:["$","section",null,{"className":"pb-12","children":["$","div",null,{"className":"max-w-[800px] mx-auto px-5","children":[["$","h2",null,{"className":"text-2xl font-bold mb-8","children":[3," Interview Questions with STAR Answers"]}],["$","div",null,{"className":"space-y-8","children":[["$","div","0",{"className":"bg-white rounded-2xl border border-neutral-200 p-6 md:p-8","children":[["$","div",null,{"className":"flex items-start gap-3 mb-6","children":[["$","span",null,{"className":"shrink-0 w-8 h-8 rounded-lg bg-primary text-white text-sm font-bold flex items-center justify-center","children":1}],["$","h3",null,{"className":"text-lg font-bold","children":"Tell me about a time you had to earn the trust of a skeptical stakeholder."}]]}],["$","div",null,{"className":"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6","children":[["$","div","Situation",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-blue-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Situation"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I joined a project where the engineering team had lost confidence in the product team after a series of poorly scoped requirements."}]]}],["$","div","Task",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-green-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Task"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"As the new product manager, I needed to rebuild trust between the two teams before we could ship the next release."}]]}],["$","div","Action",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-amber-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Action"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"I scheduled individual 1:1s with every engineer on the team to understand their frustrations. I created a shared requirements template with acceptance criteria, committed to attending every sprint planning session, and followed through on every promise I made — no matter how small. When I didn't have an answer, I said so instead of guessing."}]]}],["$","div","Result",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Result"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"Within 6 weeks, the engineering team's satisfaction scores improved from 2.1 to 4.3 out of 5. The product-engineering collaboration became a model for other teams, and I was asked to present the framework at our quarterly review."}]]}]]}],["$","div",null,{"className":"bg-amber-50 border border-amber-200 rounded-xl p-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-800 mb-2","children":"💡 Tips for this answer"}],["$","ul",null,{"className":"space-y-1","children":[["$","li","0",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Show you earn trust through actions, not words."}]]}],["$","li","1",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Demonstrate you listen before trying to fix things."}]]}],["$","li","2",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Highlight follow-through — trust is built by keeping small promises consistently."}]]}]]}]]}]]}],["$","div","1",{"className":"bg-white rounded-2xl border border-neutral-200 p-6 md:p-8","children":[["$","div",null,{"className":"flex items-start gap-3 mb-6","children":["$L25","$L26"]}],"$L27","$L28"]}],"$L29"]}]