r."}]]}],["$","div","Result",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Result"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"We launched 3 weeks ahead of our original schedule and 3 weeks after the competitor. Our offline feature drove 35% of initial adoption and became our most-requested capability in sales demos."}]]}]]}],["$","div",null,{"className":"bg-amber-50 border border-amber-200 rounded-xl p-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-800 mb-2","children":"💡 Tips for this answer"}],["$","ul",null,{"className":"space-y-1","children":[["$","li","0",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Show you analyzed the risk, not just acted impulsively."}]]}],["$","li","1",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Demonstrate you had a clear rationale for the trade-offs."}]]}],["$","li","2",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Highlight the competitive advantage your speed created."}]]}]]}]]}]]}]
