ding-relaxed mt-2","children":"I quickly assessed the blast radius — 30% of our enterprise customers used this integration. I gathered my team, estimated the effort for each option, and decided to build a temporary adapter using the partner's new API endpoint. I assigned two engineers to the adapter and one to customer communication. We shipped the fix by Sunday evening."}]]}],["$","div","Result",{"className":"bg-neutral-50 rounded-xl p-4","children":[["$","span",null,{"className":"bg-purple-500 text-white text-xs font-bold px-2 py-1 rounded mb-2 inline-block","children":"Result"}],["$","p",null,{"className":"text-sm text-neutral-700 leading-relaxed mt-2","children":"Zero customer downtime. The adapter became the foundation for a more robust integration layer that handled future API changes gracefully. My manager praised the speed of the decision and the risk assessment I did under pressure."}]]}]]}],["$","div",null,{"className":"bg-amber-50 border border-amber-200 rounded-xl p-4","children":[["$","p",null,{"className":"text-xs font-semibold text-amber-800 mb-2","children":"💡 Tips for this answer"}],["$","ul",null,{"className":"space-y-1","children":[["$","li","0",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Show you assess risk quickly, not recklessly."}]]}],["$","li","1",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Demonstrate you mobilize resources fast when time is critical."}]]}],["$","li","2",{"className":"text-sm text-amber-700 flex items-start gap-2","children":[["$","span",null,{"children":"•"}],["$","span",null,{"children":"Highlight that the quick decision led to a lasting improvement."}]]}]]}]]}]]}],["$","div","1",{"className":"bg-white rounded-2xl border border-neutral-200 p-6 md:p-8","children":["$L25","$L26","$L27"]}],"$L28"]}]]}]}]
